# Copy to .env for local development. Never commit real values.
# Status vocabulary follows docs/RUNTIME_CONFIG_CONTRACT.md.

APP_ENV=dev
PLATFORM_VERSION=0.1.0
GIT_COMMIT=local

# DERIVED_AT_DEPLOY in real environments
DATABASE_URL=postgresql+psycopg://chann:chann@localhost:5432/chann_crm_ai
REDIS_URL=redis://localhost:6379/0
DATA_BASE_URL=http://localhost:8081

# REQUIRED_NOT_CONFIGURED — Phase 1 cannot be closed without these
ADMIN_SECRET=dev-internal-secret
JWT_SECRET=dev-jwt-secret
LINE_CUSTOMER_CHANNEL_SECRET=
LINE_CUSTOMER_CHANNEL_ACCESS_TOKEN=
LINE_SALES_CHANNEL_SECRET=
LINE_SALES_CHANNEL_ACCESS_TOKEN=
LINE_TECHNICIAN_CHANNEL_SECRET=
LINE_TECHNICIAN_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LIFF_CUSTOMER_ID=
NEXT_PUBLIC_LIFF_SALES_ID=
NEXT_PUBLIC_LIFF_TECHNICIAN_ID=

# DEV only. Outside dev the seed refuses to run without this.
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

# OPTIONAL_UNTIL_PHASE_4
